# copy to .env and fill in

# Postgres — runtime uses the POOLED url, migrations use the DIRECT url.
# Locally the two are identical (docker-compose provides this exact URL, no pooler).
# In prod: DATABASE_URL = Neon pooled (host has -pooler), DIRECT_URL = Neon direct.
DATABASE_URL=postgresql://klar:klar@localhost:5432/klarbase
DIRECT_URL=postgresql://klar:klar@localhost:5432/klarbase

# better-auth — generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth apps — GitHub: https://github.com/settings/developers
#   callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
#   callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# client origin (dev Vite server)
CLIENT_ORIGIN=http://localhost:5173

PORT=3000
