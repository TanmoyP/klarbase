{
  "name": "klarbase",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "server",
    "client"
  ],
  "scripts": {
    "test": "node core/test/isles.mjs && node core/test/run.mjs",
    "dev:server": "npm run dev -w @klar/server",
    "dev:client": "npm run dev -w @klar/client",
    "build": "npm run build -w @klar/client",
    "check": "node --check server/src/index.js && node --check client/src/main.js && node --check client/src/builder.js",
    "check:isles": "node tools/check-isles.mjs",
    "author": "node tools/author.mjs"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
